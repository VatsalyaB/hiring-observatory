# Postgres
POSTGRES_USER=observatory
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=observatory
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Role used by the publishing pipeline. Must never be able to read the private schema.
PUBLISHER_PASSWORD=change-me-different-long-random

# n8n variables removed 2026-08-09 (D-011) — the scheduler is GitHub Actions and the raw store is
# a private git repository. Nothing here hosts an orchestrator any more.
#
# Production secrets (Adzuna app_id/app_key, etc.) belong in GitHub Actions repository secrets,
# never in this file and never in .env. See docs/DECISIONS.md D-011.

# Region-neutral default for the host, not for the data. Data timezones live in `countries`.
TZ=Pacific/Auckland

# Optional hosted reviewer-feedback configuration. These values are non-committable; keep them in
# local or hosted configuration only. SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are public browser
# configuration values when copied to feedback-config.mjs, but .env itself must never be committed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Non-committable moderator secret. Set this only with supabase secrets set; never put it in
# browser configuration, a repository file, or a local auth session.
MODERATOR_GITHUB_LOGINS=
